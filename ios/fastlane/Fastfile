default_platform(:ios)

platform :ios do
  desc "Build and upload student app to TestFlight"
  lane :ci_testflight do
    setup_ci

    keychain_path = File.expand_path("~/Library/Keychains/fastlane_tmp_keychain-db")
    keychain_password = ENV.fetch("MATCH_KEYCHAIN_PASSWORD", "")

    p12_password = ENV.fetch("IOS_DISTRIBUTION_P12_PASSWORD_CLEAN", ENV.fetch("IOS_DISTRIBUTION_P12_PASSWORD"))
    sh("security import \"#{ENV.fetch("IOS_DISTRIBUTION_P12_PATH")}\" -k \"#{keychain_path}\" -P \"#{p12_password}\" -T /usr/bin/codesign -T /usr/bin/security")
    sh("security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k \"#{keychain_password}\" \"#{keychain_path}\"")
    sh("security find-identity -v -p codesigning ~/Library/Keychains/fastlane_tmp_keychain-db | grep -E 'Apple Distribution|iPhone Distribution'")

    sh("mkdir -p ~/Library/MobileDevice/Provisioning\\ Profiles && cp \"#{ENV.fetch("IOS_APPSTORE_PROFILE_PATH")}\" ~/Library/MobileDevice/Provisioning\\ Profiles/")
    profile_plist = "/tmp/ci_profile.plist"
    sh("security cms -D -i \"#{ENV.fetch("IOS_APPSTORE_PROFILE_PATH")}\" > #{profile_plist}")

    profile_name = sh("/usr/libexec/PlistBuddy -c 'Print :Name' #{profile_plist}").strip
    profile_uuid = sh("/usr/libexec/PlistBuddy -c 'Print :UUID' #{profile_plist}").strip
    profile_app_identifier = sh("/usr/libexec/PlistBuddy -c 'Print :Entitlements:application-identifier' #{profile_plist}").strip
    bundle_id = ENV.fetch("IOS_BUNDLE_ID").strip
    profile_bundle_id = profile_app_identifier.include?(".") ? profile_app_identifier.split('.', 2).last : profile_app_identifier

    UI.message("Bundle ID from secret: #{bundle_id}")
    UI.message("Bundle ID from profile: #{profile_bundle_id}")

    if profile_bundle_id != bundle_id
      UI.user_error!("Bundle ID mismatch: IOS_BUNDLE_ID='#{bundle_id}' but profile has '#{profile_bundle_id}'")
    end

    api_key_content = ENV.fetch("APP_STORE_CONNECT_API_KEY")
    api_key_is_base64 = !api_key_content.include?("BEGIN PRIVATE KEY")
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: api_key_content,
      is_key_content_base64: api_key_is_base64,
      duration: 1200,
    )

    begin
      latest_testflight_build_number(
        api_key: api_key,
        app_identifier: bundle_id,
        platform: "ios",
        initial_build_number: 1,
      )
      UI.success("App Store Connect API access check passed for bundle id: #{bundle_id}")
    rescue => e
      UI.user_error!("App Store Connect API key can't access app '#{bundle_id}'. Ensure key is Team Key, same team as app, role App Manager/Admin, and app access includes this app. Original error: #{e.message}")
    end

    sh("cd .. && flutter --version")
    sh("cd .. && flutter pub get")
    sh("pod install --repo-update")

    update_project_team(
      path: "Runner.xcodeproj",
      teamid: ENV.fetch("APPLE_TEAM_ID"),
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      profile_uuid: profile_uuid,
      targets: ["Runner"],
    )

    update_app_identifier(
      xcodeproj: "Runner.xcodeproj",
      plist_path: "Runner/Info.plist",
      app_identifier: bundle_id,
    )

    begin
      build_ios_app(
        workspace: "Runner.xcworkspace",
        scheme: "Runner",
        configuration: "Release",
        clean: true,
        export_method: "app-store",
        skip_profile_detection: true,
        output_directory: "../build/ios",
        output_name: "stagelink_student.ipa",
        export_options: {
          method: "app-store",
          signingStyle: "manual",
          teamID: ENV.fetch("APPLE_TEAM_ID"),
          provisioningProfiles: {
            bundle_id => profile_name,
          },
        },
      )
    rescue => e
      sh("echo '===== RAW XCODEBUILD ERRORS ====='")
      sh("if [ -f ~/Library/Logs/gym/Runner-Runner.log ]; then grep -nE 'error:|Error:|xcodebuild: error|exportArchive|IDEDistribution' ~/Library/Logs/gym/Runner-Runner.log | tail -n 160; fi")
      sh("if [ -f ~/Library/Logs/gym/Runner-Runner.log ]; then echo '===== LAST 500 LINES ====='; tail -n 500 ~/Library/Logs/gym/Runner-Runner.log; fi")
      raise e
    end

    if ENV.fetch("SKIP_TESTFLIGHT_UPLOAD", "false") == "true"
      UI.important("SKIP_TESTFLIGHT_UPLOAD=true => skipping TestFlight upload. IPA is ready in build artifacts.")
      next
    end

    upload_to_testflight(
      api_key: api_key,
      app_identifier: bundle_id,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
    )
  end
end
