require "base64"
require "fileutils"
require "tmpdir"
require "shellwords"
require "digest"
require "openssl"

default_platform(:ios)

platform :ios do
  desc "Build and upload student app to TestFlight"
  lane :testflight do
    required = %w[
      APP_STORE_CONNECT_ISSUER_ID
      APP_STORE_CONNECT_KEY_ID
      APP_STORE_CONNECT_API_KEY
      APPLE_TEAM_ID
      IOS_BUNDLE_ID
      IOS_DISTRIBUTION_P12_BASE64
      IOS_DISTRIBUTION_P12_PASSWORD
      IOS_APPSTORE_PROFILE_BASE64
    ]

    missing = required.select { |k| ENV[k].to_s.strip.empty? }
    UI.user_error!("Missing required environment variables: #{missing.join(', ')}") unless missing.empty?

    api_key_content = ENV["APP_STORE_CONNECT_API_KEY"].to_s
    api_key_is_base64 = !api_key_content.include?("BEGIN PRIVATE KEY")

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: api_key_content,
      is_key_content_base64: api_key_is_base64,
      duration: 1200,
      in_house: false,
    )

    keychain_password = ""
    setup_ci(keychain_name: "fastlane_tmp_keychain") if ENV["CI"]

    temp_dir = File.join(Dir.tmpdir, "stagelink_signing")
    FileUtils.mkdir_p(temp_dir)

    p12_path = File.join(temp_dir, "distribution.p12")
    profile_path = File.join(temp_dir, "appstore.mobileprovision")
    profile_plist = File.join(temp_dir, "profile.plist")
    keychain_path = Actions.lane_context[SharedValues::KEYCHAIN_PATH].to_s
    keychain_path = File.expand_path(keychain_path) unless keychain_path.empty?
    keychain_path = File.expand_path("~/Library/Keychains/fastlane_tmp_keychain-db") if keychain_path.empty?
    if !File.exist?(keychain_path) && !keychain_path.end_with?("-db") && File.exist?("#{keychain_path}-db")
      keychain_path = "#{keychain_path}-db"
    end

    p12_base64 = ENV["IOS_DISTRIBUTION_P12_BASE64"].to_s.gsub(/\s+/, "")
    p12_password = ENV["IOS_DISTRIBUTION_P12_PASSWORD"].to_s
    p12_password_stripped = p12_password.strip
    UI.important("IOS_DISTRIBUTION_P12_PASSWORD contains leading/trailing whitespace; it will be trimmed") if p12_password != p12_password_stripped

    begin
      p12_binary = Base64.strict_decode64(p12_base64)
    rescue ArgumentError => e
      UI.user_error!("Invalid IOS_DISTRIBUTION_P12_BASE64 value: #{e.message}")
    end

    File.binwrite(p12_path, p12_binary)
    File.binwrite(profile_path, Base64.decode64(ENV["IOS_APPSTORE_PROFILE_BASE64"]))

    UI.message("Signing debug: p12_bytes=#{File.size(p12_path)}, p12_sha256=#{Digest::SHA256.file(p12_path).hexdigest[0,16]}, pass_len=#{p12_password_stripped.length}")

    begin
      OpenSSL::PKCS12.new(File.binread(p12_path), p12_password_stripped)
    rescue OpenSSL::PKCS12::PKCS12Error => e
      UI.user_error!("P12 validation failed before keychain import. IOS_DISTRIBUTION_P12_BASE64 and IOS_DISTRIBUTION_P12_PASSWORD do not match. Details: #{e.message}")
    end

    sh("security import #{Shellwords.escape(p12_path)} -k #{Shellwords.escape(keychain_path)} -P #{Shellwords.escape(p12_password_stripped)} -A -T /usr/bin/codesign -T /usr/bin/security")
    sh("security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k #{Shellwords.escape(keychain_password)} #{Shellwords.escape(keychain_path)}")
    sh("security find-identity -v -p codesigning #{Shellwords.escape(keychain_path)}")

    sh("security cms -D -i '#{profile_path}' > '#{profile_plist}'")

    profile_name = sh(%Q{/usr/libexec/PlistBuddy -c "Print :Name" "#{profile_plist}"}).strip
    profile_uuid = sh(%Q{/usr/libexec/PlistBuddy -c "Print :UUID" "#{profile_plist}"}).strip
    profile_app_id = sh(%Q{/usr/libexec/PlistBuddy -c "Print :Entitlements:application-identifier" "#{profile_plist}"}).strip
    profile_bundle_id = profile_app_id.split('.', 2)[1].to_s

    UI.user_error!("Bundle ID mismatch: profile has '#{profile_bundle_id}' but IOS_BUNDLE_ID is '#{ENV['IOS_BUNDLE_ID']}'") if profile_bundle_id != ENV["IOS_BUNDLE_ID"]

    profile_install_dir = File.expand_path("~/Library/MobileDevice/Provisioning Profiles")
    FileUtils.mkdir_p(profile_install_dir)
    FileUtils.cp(profile_path, File.join(profile_install_dir, "#{profile_uuid}.mobileprovision"))

    update_project_team(
      path: "Runner.xcodeproj",
      teamid: ENV["APPLE_TEAM_ID"],
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: ENV["APPLE_TEAM_ID"],
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      profile_uuid: profile_uuid,
    )

    update_app_identifier(
      xcodeproj: "Runner.xcodeproj",
      plist_path: "Runner/Info.plist",
      app_identifier: ENV["IOS_BUNDLE_ID"],
    )

    increment_build_number(
      xcodeproj: "Runner.xcodeproj",
      build_number: ENV.fetch("GITHUB_RUN_NUMBER", Time.now.to_i.to_s),
    )

    build_ios_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      clean: true,
      export_method: "app-store",
      skip_profile_detection: true,
      export_options: {
        signingStyle: "manual",
        method: "app-store",
        teamID: ENV["APPLE_TEAM_ID"],
        provisioningProfiles: {
          ENV["IOS_BUNDLE_ID"] => profile_name,
        },
      },
      output_directory: "../build/ios",
      output_name: "stagelink_student.ipa",
      include_symbols: true,
      include_bitcode: false,
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
    )
  end
end
