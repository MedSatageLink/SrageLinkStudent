default_platform(:ios)

platform :ios do
  desc "Build and upload student app to TestFlight"
  lane :testflight do
    required = %w[
      APP_STORE_CONNECT_API_KEY_ID
      APP_STORE_CONNECT_ISSUER_ID
      APP_STORE_CONNECT_API_KEY_BASE64
      APPLE_TEAM_ID
      IOS_BUNDLE_ID
      MATCH_GIT_URL
      MATCH_PASSWORD
    ]

    missing = required.select { |k| ENV[k].to_s.strip.empty? }
    UI.user_error!("Missing required environment variables: #{missing.join(', ')}") unless missing.empty?

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_BASE64"],
      is_key_content_base64: true,
      duration: 1200,
      in_house: false,
    )

    setup_ci if ENV["CI"]

    update_code_signing_settings(
      use_automatic_signing: true,
      path: "Runner.xcodeproj",
      team_id: ENV["APPLE_TEAM_ID"],
    )

    update_project_team(
      path: "Runner.xcodeproj",
      teamid: ENV["APPLE_TEAM_ID"],
    )

    update_app_identifier(
      xcodeproj: "Runner.xcodeproj",
      plist_path: "Runner/Info.plist",
      app_identifier: ENV["IOS_BUNDLE_ID"],
    )

    match(
      type: "appstore",
      app_identifier: [ENV["IOS_BUNDLE_ID"]],
      api_key: api_key,
      readonly: false,
      git_url: ENV["MATCH_GIT_URL"],
      git_branch: ENV.fetch("MATCH_GIT_BRANCH", "main"),
    )

    increment_build_number(
      xcodeproj: "Runner.xcodeproj",
      build_number: ENV.fetch("GITHUB_RUN_NUMBER", Time.now.to_i.to_s),
    )

    build_ios_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      clean: true,
      export_method: "app-store",
      output_directory: "../build/ios",
      output_name: "stagelink_student.ipa",
      include_symbols: true,
      include_bitcode: false,
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
    )
  end
end
